{
  "name": "have-you-seen-my-shell",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:frontend": "vite --configLoader runner",
    "dev:worker": "wrangler dev",
    "dev": "concurrently -n frontend,worker -c cyan,green \"npm run dev:frontend\" \"npm run dev:worker\"",
    "build": "vite build --configLoader runner",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && wrangler deploy",
    "d1:migrate": "wrangler d1 migrations apply have-you-seen-my-shell",
    "d1:seed": "wrangler d1 execute have-you-seen-my-shell --file=scripts/seed.sql"
  },
  "dependencies": {
    "hono": "4.13.20",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "7.18.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261121.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "9.2.5",
    "typescript": "^5.7.2",
    "vite": "6.4.6",
    "wrangler": "4.166.0"
  },
  "overrides": {
    "baseline-browser-mapping": "2.11.0",
    "browserslist": "4.29.6",
    "nanoid": "3.3.18",
    "postcss": "8.5.33",
    "source-map-js": "1.2.2",
    "@babel/core": "7.29.6"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "workerd@1.20261119.1": true
  }
}
